<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="#CC202124">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/btn_in" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="Clock In" />
        <Button android:id="@+id/btn_out" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:text="Clock Out" />
    </LinearLayout>
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Ready" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center" />
</LinearLayout>
